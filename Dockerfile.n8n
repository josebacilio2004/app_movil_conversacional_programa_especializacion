FROM n8nio/n8n:latest

USER root

# Copiar script de inicialización dinámico y asegurar permisos
COPY docker-entrypoint-custom.sh /docker-entrypoint-custom.sh
RUN chmod +x /docker-entrypoint-custom.sh && \
    mkdir -p /home/node/.n8n && \
    chown -R node:node /home/node/.n8n && \
    chmod 700 /home/node/.n8n

# Proxy y estabilidad para Render y Cloudflare
ENV N8N_PROXY_HOPS=1 \
    N8N_EDITOR_BASE_URL=https://horizonte-n8n.onrender.com/ \
    WEBHOOK_URL=https://horizonte-n8n.onrender.com/ \
    N8N_WEBHOOK_URL=https://horizonte-n8n.onrender.com/ \
    DB_POSTGRESDB_POOL_SIZE=5 \
    NODE_OPTIONS="--max-old-space-size=400" \
    EXECUTIONS_DATA_SAVE_ON_ERROR=all \
    EXECUTIONS_DATA_SAVE_ON_SUCCESS=none \
    EXECUTIONS_DATA_SAVE_ON_PROGRESS=false \
    EXECUTIONS_DATA_PRUNE=true \
    EXECUTIONS_DATA_MAX_AGE=24 \
    N8N_CONCURRENCY_PRODUCTION_LIMIT=10

USER node

ENTRYPOINT ["/docker-entrypoint-custom.sh"]
